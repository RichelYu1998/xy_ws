# Auto detect text files and perform LF normalization
* text=auto

# Force LF for specific file types
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.bat text eol=crlf
*.sh text eol=lf
*.json text eol=lf
*.docx binary

# Normalize all text files to UTF-8
*.md text working-tree-encoding=UTF-8
*.py text working-tree-encoding=UTF-8
*.js text working-tree-encoding=UTF-8