# ============================================================
# Git 忽略清单 —— 说明本仓库哪些文件只应留在本地、不入版本库
# 规则：一行一条，# 开头为注释，! 开头表示反向放行
# 维护要求：新增任何生成物 / 敏感文件时，必须在同一次改动内补到这里
# ============================================================

# ---------- 虚拟环境 ----------
.venv/

# ---------- Python 运行缓存 ----------
__pycache__/
*.pyc

# ---------- 编辑器与 IDE 工程目录 ----------
.idea/
.vscode/

# ---------- 前端源码与依赖 ----------
frontend/
**/node_modules/

# ---------- 后端源码 ----------
backend/

# ---------- 业务数据（商品数据，属私有数据，绝不入库） ----------
file/*.json
file/*.json.backup
file/*.backup
file/*_cache.json

# ---------- 运行时产物（由 run.sh / run.bat / 看门狗生成，每次运行都会变） ----------
file/*.log
file/_*.log
file/_*.json
file/*.pid
file/watchdog.pid
file/_api_check.*
file/_srv*.log
file/_runsh*.log
file/_pw_*

# ---------- 隧道公网地址（每次启动由 cloudflared 动态生成） ----------
file/tunnel_url.txt

# ---------- 控制台输出日志（运行产物） ----------
file/web_output.log

# ---------- 敏感配置（含账号、密钥、Cookie，绝不入库） ----------
config/cookies.json
config/config.json
config/.encryption_key
config/.salt

# ---------- 清理白名单（含真实本机路径，绝不入库） ----------
# 真实白名单不入库；脱敏格式示例 config/clean_allowed_roots.example.txt 需入库
config/clean_allowed_roots.txt

# ---------- 环境变量文件（含凭证，绝不入库） ----------
.env
.env.*
*.env

# ---------- 加解密临时工具（安全敏感，不对外分发） ----------
config/update_password.py
config/demo_crypto.py

# ---------- 内置第三方工具链（体积 1.1GB，由安装脚本按需下载，绝不入库） ----------
tools/

# ---------- 系统与运行残留（macOS 元数据、清理日志） ----------
.DS_Store
clean_files.log