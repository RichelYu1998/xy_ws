# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# IDE files
.idea/
.vscode/

# Frontend build
frontend/
**/node_modules/

# Backend
backend/

# Data files (business data, never commit)
file/*.json
file/*.json.backup
file/*.backup
file/*_cache.json

# Runtime artifacts (logs / snapshots / pids generated by run.sh / run.bat / watchdog)
file/*.log
file/_*.log
file/_*.json
file/*.pid
file/watchdog.pid
file/_api_check.*
file/_srv*.log
file/_runsh*.log
file/_pw_*

# Tunnel URL
file/tunnel_url.txt

# Web output log
file/web_output.log

# Sensitive config files
config/cookies.json
config/config.json
config/.encryption_key
config/.salt

# Crypto tool (security sensitive, not for distribution)
config/crypto_tool.py
config/update_password.py
config/demo_crypto.py

# OS files
.DS_Store
Thumbs.db
*.lnk

# Temporary files
temp/
*.tmp
~$*

# Log files
*.log
clean_files.log

# Get scripts (not to be uploaded)
get*.py

# Fix scripts (temporary, not to be uploaded)
fix*.py

# Exception: Official automation tools (should be committed)
!test/fix_readme_and_sync.py

# Version file (managed in code, not standalone)
version.txt

# Playwright browsers (large files, should be downloaded on first run)
playwright-browsers/

# Build tools (pandoc for skill.docx generation, not project code)
tools/
*.msi
*.zip