{
  "_comment": "配置模板（已脱敏）。用法：复制为同目录 config/config.json 后逐项替换 YOUR_* 占位符。字段说明：login=微购账号密码与登录方式；target_url=要采集的相册店铺地址；scroll_config=列表滚动采集参数（最大尝试次数/同高度停滞上限/滚动等待秒数/弹窗关闭间隔与次数）；headers=请求头（cookie 可留占位，实际优先读 cookie_file）；cookies=直接内联的 Cookie 列表，留空则读 config/cookies.json；output_file=采集结果 JSON 输出路径；cookie_file=Cookie 文件路径；excel_files=本地 Excel 货号表路径列表，支持 Windows/macOS 写法与 ~ 展开；email_notification_enabled=是否开启邮件通知；email_smtp_*=SMTP 服务器与授权码；email_to=收件人；tunnel_type=内网穿透类型（hostc/cloudflared）；web_api_key=Web 接口鉴权 Key，留空则启动时自动生成。",
  "login": {
    "username": "YOUR_QQ_PHONE_NUMBER",
    "password": "YOUR_PASSWORD",
    "login_type": "phone"
  },
  "target_url": "https://www.szwego.com/kuikly_static/index.html?page_name=personal_album_page&shopId=YOUR_SHOP_ID",
  "scroll_config": {
    "max_attempts": 30,
    "same_height_limit": 8,
    "scroll_wait_time": 0.8,
    "popup_close_interval": 5,
    "popup_close_limit": 3,
    "popup_close_wait": 0.3,
    "dynamic_adjust": true
  },
  "headers": {
    "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;q=b3;q=0.7",
    "accept-encoding": "gzip, deflate, br, zstd",
    "accept-language": "zh-CN,zh;q=0.9",
    "cache-control": "max-age=0",
    "connection": "keep-alive",
    "cookie": "YOUR_COOKIE_OR_USE_COOKIES_JSON",
    "host": "www.szwego.com",
    "sec-ch-ua": "\"Chromium\";v=\"146\", \"Not-A.Brand\";v=\"24\", \"Google Chrome\";v=\"146\"",
    "sec-ch-ua-mobile": "?0",
    "sec-ch-ua-platform": "\"Windows\"",
    "sec-fetch-dest": "document",
    "sec-fetch-mode": "navigate",
    "sec-fetch-site": "none",
    "sec-fetch-user": "?1",
    "upgrade-insecure-requests": "1",
    "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"
  },
  "cookies": [],
  "output_file": "file/output.json",
  "cookie_file": "config/cookies.json",
  "excel_files": [
    "D:/ws/xy_ws/小旭二手机.xlsx",
    "C:\\Users\\YourUser\\Desktop\\小旭二手机.xlsx",
    "~/.xiaoxu/xiaoxu.xlsx"
  ],
  "email_notification_enabled": true,
  "email_smtp_host": "smtp.qq.com",
  "email_smtp_port": 587,
  "email_smtp_user": "your_email@qq.com",
  "email_smtp_password": "YOUR_SMTP_AUTH_CODE_16CHARS",
  "email_from_name": "Szwego爬虫通知",
  "email_to": "your_notification@email.com",
  "tunnel_type": "hostc",
  "web_api_key": "YOUR_WEB_API_KEY_OR_AUTO_GENERATE"
}