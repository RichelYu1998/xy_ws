{
  "_comment": "生产环境（production）参数集：限流更严格、缓存 TTL 更长、日志只记 WARNING 及以上，降低线上开销。字段说明：rate_limit=接口与上传的滑动窗口限流；cache=JSON/配置/静态资源的缓存有效期（秒）；alerts=CPU/内存/磁盘告警阈值（百分比）；logging=日志级别、单文件上限与备份份数；server=监听地址、端口与调试开关（生产必须为 false）。",
  "environment": "production",
  "rate_limit": {
    "api_max_requests": 100,
    "api_window_seconds": 60,
    "upload_max_requests": 5,
    "upload_window_seconds": 60
  },
  "cache": {
    "json_ttl_seconds": 60,
    "config_ttl_seconds": 300,
    "static_ttl_seconds": 3600
  },
  "alerts": {
    "cpu_percent_threshold": 85,
    "memory_percent_threshold": 85,
    "disk_percent_threshold": 90
  },
  "logging": {
    "level": "WARNING",
    "max_file_size_mb": 50,
    "backup_count": 5
  },
  "server": {
    "host": "0.0.0.0",
    "port": 5000,
    "debug": false,
    "threaded": true
  }
}