# Szwego爬虫 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ===========================================
# 登录凭证 (必填)
# ============================================
SZWEGO_USERNAME=your_phone_number
SZWEGO_PASSWORD=your_password

# ===========================================
# 邮件通知 (可选)
# ============================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_email_authorization_code
EMAIL_TO=notification@example.com

# ===========================================
# Web服务 (可选)
# ============================================
WEB_PORT=8888
WEB_API_KEY=auto_generate_if_empty

# ===========================================
# 网络配置 (可选)
# ============================================
HOST=localhost
TIMEOUT_HTTP_REQUEST=10
TIMEOUT_BROWSER_PAGE_LOAD=30

# ===========================================
# 安全配置 (建议修改)
# ============================================
ENCRYPTION_KEY=auto_generate_secure_key
JWT_SECRET=auto_generate_secure_secret